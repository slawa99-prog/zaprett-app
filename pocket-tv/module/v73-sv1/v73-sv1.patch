+sv_named() {
+    case "$1" in
+        runner) pgrep -f 'zapret[.]sh' ;;
+        resolver) pgrep -f 'dnscrypt[.]sh' ;;
+        engine) pgrep -x nfqws; pgrep -x nfqws2 ;;
+        dns) pgrep -x dnscrypt-proxy ;;
