+#!/system/bin/sh
+# Installed as <module>/curl; the ABI-specific executable is curl.bin.
+case "$0" in /*) mod=${0%/*};; *) mod=$(CDPATH= cd -- "$(dirname "$0")" && pwd) || exit 1;; esac
+if [ "$#" = 1 ]; then case "$1" in --version|-V) exec "$mod/curl.bin" --disable --version;; esac; fi
+# Stock Pocket recognizes "not found" during its loopback probe and tries the
+# next TLS client (including the APK runtime) rather than selecting a broken one.
+ca_fail() { echo "! Android CA bundle not found or unreadable; HTTPS verification unavailable" >&2; exit 77; }
+umask 077
+apex=/apex/com.android.conscrypt/cacerts
+legacy=/system/etc/security/cacerts
+# Android stores one PEM per old-subject-hash file; OpenSSL 3 expects a
+# different hash for --capath. Build a PEM bundle instead. Do not use -k.
+removed=/data/misc/user/0/cacerts-removed
+oldremoved=/data/misc/keychain/cacerts-removed
+dir="$mod/.service/sv-ca"
+[ -d "$dir" ] || { mkdir -p "$dir" && chmod 700 "$dir"; } || ca_fail
+IFS= read -r boot < /proc/sys/kernel/random/boot_id || ca_fail
+case "$boot" in ''|*[!a-fA-F0-9-]*) ca_fail;; esac
+bundle="$dir/$boot.pem"
+if [ ! -s "$bundle" ] || [ "$apex" -nt "$bundle" ] || [ "$legacy" -nt "$bundle" ] || [ "$removed" -nt "$bundle" ] || [ "$oldremoved" -nt "$bundle" ]; then
+    tmp=$(mktemp "$dir/.ca.XXXXXX") || ca_fail
+    trap 'rm -f "$tmp"' 0
+    # A subshell owns the certificate argv, leaving curl's original argv intact.
+    (
+        set -- "$apex"/????????.[0-9]*
+        if [ -f "$1" ] && [ "$(getprop system.certs.enabled 2>/dev/null)" != true ]; then trust=$apex; else trust=$legacy; fi
+        set --
+        for f in "$trust"/????????.[0-9]*; do
+            [ -f "$f" ] || continue
+            name=${f##*/}
+            [ ! -e "$removed/$name" ] && [ ! -e "$oldremoved/$name" ] || continue
+            set -- "$@" "$f"
+        done
+        [ "$#" -gt 0 ] || exit 1
+        awk '/^-----BEGIN CERTIFICATE-----\r?$/{if(on)bad=1;on=1}
+             on{print} /^-----END CERTIFICATE-----\r?$/{if(!on)bad=1;on=0;n++}
+             END{if(bad||on||!n)exit 1}' "$@" > "$tmp"
+    ) && [ -s "$tmp" ] && mv -f "$tmp" "$bundle" || ca_fail
+    trap - 0
+    # Keep at most this boot across normal restarts. Never remove another builder's temp.
+    for f in "$dir"/*.pem; do [ "$f" = "$bundle" ] || rm -f "$f"; done
+fi
+exec "$mod/curl.bin" --disable --cacert "$bundle" "$@"
