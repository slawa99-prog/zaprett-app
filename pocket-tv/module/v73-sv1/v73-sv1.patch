+# Only list data is staged here. No downloaded file is executed. The background
+# worker never writes live lists or restarts the service.
+sv_list_vars() {
+    case "$1" in
+      general) dest="$LIST_DIR/list-general.txt"; url=$(read_link_file "$LIST_GENERAL_LINK" "$LIST_GENERAL_LINK_LEGACY");;
+      cloaking) dest="$DNSCRYPT_DIR/cloaking-rules.txt"; url=$(read_link_file "$DNSCRYPT_CLOAKING_LINK" "$DNSCRYPT_CLOAKING_LINK_LEGACY");;
+      names) dest="$DNSCRYPT_DIR/blocked-names.txt"; url=$(read_link_file "$DNSCRYPT_BLOCKED_NAMES_LINK" "$DNSCRYPT_BLOCKED_NAMES_LINK_LEGACY");;
+      ips) dest="$DNSCRYPT_DIR/blocked-ips.txt"; url=$(read_link_file "$DNSCRYPT_BLOCKED_IPS_LINK");;
+      ipset)
+        if [ "${SV_MANUAL_IPSET:-0}" != 1 ]; then case "$(cat "$CONFIG_DIR/ipset-filter" 2>/dev/null)" in
+            none|loaded) return 1;; any) :;; *) [ -s "$LIST_DIR/ipset-all.txt" ] || return 1
+                if [ "$(wc -l < "$LIST_DIR/ipset-all.txt")" -eq 1 ] && grep -Fxq '203.0.113.113/32' "$LIST_DIR/ipset-all.txt"; then return 1; fi;;
+        esac; fi
+        dest="$SERVICE_DIR/ipset-service.txt"
+        url=$(read_link_file "$CONFIG_DIR/ipset-link") || url=https://raw.githubusercontent.com/sevcator/zapret-lists/refs/heads/main/ipset-service.txt;;
+      *) return 1;;
+    esac
+    case "$url" in https://*|http://*) :;; *) return 1;; esac
+    key=$(printf '%s' "$url" | sha256sum | awk '{print $1}')
+    [ "${#key}" = 64 ] || return 1
+    pool="$SERVICE_DIR/sv-list-cache"; slot="$pool/$1-$key"
+}
+sv_list_ok() {
+    [ -f "$2" ] && [ ! -L "$2" ] && [ -s "$2" ] || return 1
+    LC_ALL=C awk -v id="$1" '
+      {sub(/\r$/,""); if($0=="### ZAPRET-USER-OVERLAY ###")exit;
