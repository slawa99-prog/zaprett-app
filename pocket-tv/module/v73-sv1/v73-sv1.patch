+# Source after upstream common.sh; the APK verifies the exact bytes of common.sh.
+# A PID/comm by itself does not identify a module process. Every destructive
+# signal is checked again against procfs identity, including the start tick.
+sv_tick() (
+    case "$1" in ''|*[!0-9]*|0|1) exit 1;; esac
+    [ -r "/proc/$1/stat" ] || exit 1
+    IFS= read -r line < "/proc/$1/stat" || exit 1
+    unset IFS; set -f; set -- ${line##*) }
+    [ "$#" -ge 20 ] || exit 1
+    case "$1" in Z|X|x) exit 1;; esac
+    printf '%s\n' "${20}"
+)
+sv_role() (
+    pid=$1; role=$2
+    tick=$(sv_tick "$pid") || exit 1
+    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || exit 1
+    case "$role" in
+        engine) [ "/proc/$pid/exe" -ef "$ZAPRET_DIR/nfqws" ] || [ "/proc/$pid/exe" -ef "$ZAPRET_DIR/nfqws2" ] || exit 1;;
+        dns) [ "/proc/$pid/exe" -ef "$DNSCRYPT_DIR/dnscrypt-proxy" ] || exit 1;;
+        runner|resolver)
+            case "${exe##*/}" in sh|ash|mksh|bash|dash|busybox|toybox) :;; *) exit 1;; esac
+            if [ "$role" = runner ]; then path=$ZAPRET_DIR/zapret.sh; else path=$DNSCRYPT_DIR/dnscrypt.sh; fi
+            # Compare the actual script argument, not a substring in shell -c.
+            tr '\000' '\n' < "/proc/$pid/cmdline" 2>/dev/null | awk -v s="$path" '
+              NR==1 {a=$0;sub(/^.*\//,"",a); if(a~/^(sh|ash|mksh|bash|dash)$/)i=2; else if(a~/^(toybox|busybox)$/)i=3}
+              NR==2 && i==3 && $0!~/^(ash|sh)$/ {i=0}
+              NR==i && $0==s {found=1}
+              END {exit !found}' || exit 1;;
+        *) exit 1;;
+    esac
+    [ "$(sv_tick "$pid")" = "$tick" ] || exit 1
+    printf '%s\n' "$tick"
+)
+sv_pid_path() {
+    case "$1" in runner) echo "$ZAPRET_PID_FILE";; resolver) echo "$DNSCRYPT_SUP_PID_FILE";;
+        engine) echo "$NFQWS_PID_FILE";; dns) echo "$DNSCRYPT_PID_FILE";; esac
